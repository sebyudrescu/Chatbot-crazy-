# Required: production PostgreSQL database
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"
# Optional: direct, non-pooled connection used only by database backup/restore tools.
DIRECT_URL="postgresql://user:password@direct-host:5432/database?sslmode=require"

# Required: AI generation and embeddings (server-side only)
OPENAI_API_KEY="replace-with-openai-api-key"
OPENAI_PROMPT_MODEL="gpt-4o-mini"
OPENAI_ASSIST_MODEL="gpt-4o-mini"
# Agentic core is enabled by default. Set to false only for emergency rollback
# to the previous deterministic router while diagnosing a production incident.
AGENTIC_CORE_ENABLED="true"
# Optional: WhatsApp/Instagram voice-note transcription
OPENAI_TRANSCRIPTION_MODEL="gpt-4o-mini-transcribe"

# Required: private owner access and signed session cookies
APP_ACCESS_PASSWORD="choose-at-least-16-random-characters"
APP_AUTH_SALT="replace-with-at-least-32-random-characters"
COMMERCE_CLICK_SECRET="replace-with-a-distinct-32-character-secret"
RESEND_API_KEY="re_replace_with_resend_api_key"
# Per i test Resend: LitX AI <onboarding@resend.dev>. Per i clienti usa un dominio verificato.
RESEND_FROM_EMAIL="LitX AI <notifications@your-verified-domain.example>"
OPERATIONS_ALERT_EMAIL="owner@your-domain.example"
# Optional dedicated keys. If omitted, LitX derives isolated keys from the two values above.
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WIDGET_SESSION_SECRET=""
INTEGRATION_CONFIG_ENCRYPTION_KEY=""

# Required on Vercel: protects scheduled retention and knowledge sync routes
CRON_SECRET="replace-with-at-least-32-random-characters"

# Required in production; no trailing slash
NEXT_PUBLIC_APP_URL="https://your-domain.example"

# Client self-service onboarding. Keep false until pricing, terms and support are ready.
SELF_SERVICE_SIGNUP_ENABLED="false"
TERMS_VERSION="2026-08-31"

# Stripe subscriptions. Price is fixed server-side; card data never passes through LitX.
STRIPE_SECRET_KEY="sk_test_replace_with_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_replace_with_endpoint_secret"
STRIPE_PRICE_ID="price_replace_with_subscription_price"

# Optional for high-volume vector search; PostgreSQL remains the durable fallback
PINECONE_API_KEY="replace-with-pinecone-api-key"
PINECONE_INDEX_NAME="chatbot-knowledge-base"

# Optional: advanced crawling. Internal crawler remains available without it.
FIRECRAWL_API_KEY="replace-with-firecrawl-api-key"
USE_FIRECRAWL="false"
JINA_API_KEY="replace-with-jina-api-key"
JINA_RERANK_MODEL="jina-reranker-v2-base-multilingual"

# Meta Business Messaging (required to activate WhatsApp / Instagram)
# Full owner setup: docs/META_CHANNELS_SETUP.md
META_APP_ID="replace-with-meta-app-id"
META_APP_SECRET="replace-with-meta-app-secret"
META_GRAPH_API_VERSION="replace-with-current-supported-graph-version"
META_WHATSAPP_CONFIG_ID="replace-with-embedded-signup-configuration-id"
META_VERIFY_TOKEN="replace-with-at-least-32-random-characters"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
META_TOKEN_ENCRYPTION_KEY="replace-with-a-base64-encoded-32-byte-key"
# Optional when Instagram uses a separate Meta application
META_INSTAGRAM_APP_ID=""
META_INSTAGRAM_APP_SECRET=""

# Shopify app-wide credentials. Configure once; merchants authorize their own store with OAuth.
# Allowed redirect URL: https://your-domain.example/api/shopify/oauth/callback
SHOPIFY_CLIENT_ID="replace-with-shopify-client-id"
SHOPIFY_CLIENT_SECRET="replace-with-shopify-client-secret"
# Dedicated HMAC pepper for non-reversible order lookup rate-limit keys.
ORDER_LOOKUP_PEPPER="replace-with-a-distinct-32-character-secret"
