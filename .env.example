# Required: production PostgreSQL database
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Required: AI generation and embeddings (server-side only)
OPENAI_API_KEY="replace-with-openai-api-key"
OPENAI_PROMPT_MODEL="gpt-4o-mini"
OPENAI_ASSIST_MODEL="gpt-4o-mini"

# Required: private owner access and signed session cookies
APP_ACCESS_PASSWORD="choose-at-least-16-random-characters"
APP_AUTH_SALT="replace-with-at-least-32-random-characters"

# Required on Vercel: protects scheduled retention and knowledge sync routes
CRON_SECRET="replace-with-at-least-32-random-characters"

# Required in production; no trailing slash
NEXT_PUBLIC_APP_URL="https://your-domain.example"

# Recommended: persistent production vector search
PINECONE_API_KEY="replace-with-pinecone-api-key"
PINECONE_INDEX_NAME="chatbot-knowledge-base"

# Optional: advanced crawling. Internal crawler remains available without it.
FIRECRAWL_API_KEY="replace-with-firecrawl-api-key"
USE_FIRECRAWL="false"
