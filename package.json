{
    "name": "chatbot-rag-mvp",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev --webpack",
        "build": "next build --webpack",
        "vercel-build": "prisma migrate deploy && next build --webpack",
        "start": "next start",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "audit:project": "npm run typecheck && npm run lint && npm run build",
        "test:smoke": "node scripts/smoke-test.mjs",
        "test:knowledge-formats": "node scripts/test-knowledge-formats.mjs",
        "test:widget": "node scripts/test-widget-interactions.mjs",
        "test:widget-security": "node scripts/test-widget-session-security.cjs",
        "test:rich-text": "node scripts/test-safe-rich-text.cjs",
        "test:cta": "node scripts/test-cta-policy.cjs",
        "test:commerce": "ts-node --transpile-only --project scripts/tsconfig.crawler.json scripts/test-commerce-contract.ts",
        "test:product-extractor": "ts-node --transpile-only --project scripts/tsconfig.crawler.json scripts/test-product-extractor.ts",
        "test:commerce-db": "node scripts/test-commerce-database.cjs",
        "test:commerce-security": "ts-node --transpile-only --project scripts/tsconfig.crawler.json scripts/test-commerce-security.ts",
        "test:shopify-sync": "node scripts/test-shopify-sync.cjs",
        "test:woocommerce-sync": "node scripts/test-woocommerce-sync.cjs",
        "test:crawler": "ts-node --transpile-only --project scripts/tsconfig.crawler.json scripts/test-crawler.ts",
        "test:crawler-pages": "ts-node --transpile-only --project scripts/tsconfig.crawler.json scripts/test-crawler-pages.ts",
        "test:conversation-guidance": "ts-node --transpile-only --project scripts/tsconfig.crawler.json scripts/test-conversation-guidance.ts",
        "test:grounding-policy": "ts-node --transpile-only --project scripts/tsconfig.crawler.json scripts/test-grounding-policy.ts",
        "test:commerce-intelligence": "ts-node --transpile-only --project scripts/tsconfig.crawler.json scripts/test-commerce-intelligence.ts",
        "test:automations": "node scripts/run-automation-tests.cjs",
        "test:meta": "node scripts/test-meta-security.cjs",
        "test:meta-onboarding": "node scripts/test-meta-onboarding.cjs",
        "test:meta-connections": "node scripts/test-meta-connections.cjs",
        "test:meta-attachments": "node scripts/test-meta-attachments.cjs",
        "test:channel-rate-limit": "node scripts/test-channel-rate-limit.cjs",
        "test:channel-actions": "node scripts/test-channel-action-presentation.cjs",
        "test:email": "node scripts/test-email-notifications.cjs",
        "test:memory": "node scripts/test-memory-retrieval.cjs",
        "test:auth": "node scripts/test-owner-session.cjs",
        "test:prompt": "node scripts/test-agent-instructions.cjs",
        "test:evaluations": "node scripts/evaluate-agents.mjs",
        "test:quality": "node scripts/test-quality-signals.cjs",
        "test:observability": "ts-node --transpile-only --project scripts/tsconfig.crawler.json scripts/test-operational-observability.ts",
        "test:http-security": "ts-node --transpile-only --project scripts/tsconfig.crawler.json scripts/test-http-security.ts",
        "test:public-agent-bundle": "node scripts/test-public-agent-bundle.mjs",
        "test:recovery-safety": "node scripts/test-database-recovery-safety.mjs",
        "db:backup": "node scripts/database-recovery.mjs backup",
        "db:restore-drill": "node scripts/database-recovery.mjs drill",
        "postinstall": "prisma generate",
        "db:push": "prisma db push",
        "db:studio": "prisma studio",
        "worker": "node -r esbuild-register worker.ts",
        "worker:simple": "node worker.js"
    },
    "dependencies": {
        "@fontsource-variable/inter": "5.3.0",
        "@mendable/firecrawl-js": "^4.10.0",
        "@mozilla/readability": "^0.6.0",
        "@pinecone-database/pinecone": "^6.1.3",
        "@prisma/client": "^5.8.1",
        "axios": "^1.15.2",
        "cheerio": "^1.2.0",
        "clsx": "^2.1.0",
        "crawlee": "^3.18.0",
        "dotenv": "^17.2.3",
        "faiss-node": "^0.5.1",
        "jsdom": "^27.4.0",
        "lucide-react": "^1.24.0",
        "mammoth": "^1.12.0",
        "next": "^16.3.0",
        "openai": "^4.24.1",
        "p-queue": "^9.0.1",
        "pdf-parse": "^2.4.5",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "robots-parser": "^3.0.1",
        "server-only": "^0.0.1",
        "sharp": "^0.35.0",
        "tailwind-merge": "^2.2.0",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/node": "^20.11.5",
        "@types/pdf-parse": "^1.1.5",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "autoprefixer": "^10.4.17",
        "eslint": "^9.39.5",
        "eslint-config-next": "^16.3.0",
        "jszip": "^3.10.1",
        "postcss": "^8.5.25",
        "prisma": "^5.8.1",
        "tailwindcss": "^3.4.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.3"
    },
    "engines": {
        "node": "24.x"
    },
    "overrides": {
        "postcss": "$postcss",
        "@crawlee/browser-pool": {
            "nanoid": "3.3.17"
        },
        "js-yaml": "4.3.1",
        "minimatch@3.1.5": {
            "brace-expansion": "1.1.18"
        },
        "ip-address": "10.4.0",
        "undici": "7.29.0",
        "adm-zip": "0.6.0",
        "sharp": "$sharp"
    }
}
