// Prisma Schema for Chatbot RAG MVP

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  kind      String   @default("client")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chatbots           Chatbot[]
  memberships        WorkspaceMembership[]
  invitations        WorkspaceInvitation[]
  helpDeskSavedViews HelpDeskSavedView[]
  auditLogs          WorkspaceAuditLog[]

  @@index([kind])
  @@index([createdAt])
  @@map("workspaces")
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  displayName           String
  passwordHash          String?
  status                String    @default("active")
  mfaSecretEncrypted    String?
  mfaRecoveryCodeHashes String?
  mfaEnabledAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  memberships         WorkspaceMembership[]
  sessions            UserSession[]
  passwordResetTokens PasswordResetToken[]
  mfaChallenges       MfaChallenge[]
  invitationsCreated  WorkspaceInvitation[] @relation("WorkspaceInvitationCreator")
  workspaceAuditLogs  WorkspaceAuditLog[]

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model WorkspaceMembership {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  role        String   @default("viewer")
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, status])
  @@index([workspaceId, role])
  @@map("workspace_memberships")
}

model UserSession {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  deviceLabel String?
  ipHash      String?
  expiresAt   DateTime
  lastUsedAt  DateTime  @default(now())
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
  @@map("user_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, usedAt])
  @@map("password_reset_tokens")
}

model MfaChallenge {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, usedAt])
  @@map("mfa_challenges")
}

model WorkspaceInvitation {
  id              String    @id @default(uuid())
  workspaceId     String
  email           String
  role            String    @default("viewer")
  tokenHash       String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("WorkspaceInvitationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, email])
  @@index([email, expiresAt])
  @@index([expiresAt, acceptedAt, revokedAt])
  @@map("workspace_invitations")
}

model WorkspaceAuditLog {
  id          String   @id @default(uuid())
  workspaceId String
  actorUserId String?
  action      String
  targetType  String
  targetId    String?
  metadata    String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("workspace_audit_logs")
}

model Chatbot {
  id           String    @id @default(uuid())
  workspaceId  String
  companyName  String
  createdAt    DateTime  @default(now())
  trialEndDate DateTime?
  isActive     Boolean   @default(true)
  settings     String? // JSON string for widget settings

  // Prompt Template Configuration
  promptTemplateId String? // ID of the selected prompt template (e.g., 'customer-support', 'sales', etc.)
  systemPrompt     String? // Custom system prompt (overrides template if provided)
  promptVariables  String? // JSON string for template variables (e.g., {"COMPANY_NAME": "Acme Corp"})

  // ASYNC INGESTION: Knowledge Base Status
  kbStatus        String    @default("empty") // "empty", "indexing", "ready", "failed"
  kbLastIndexed   DateTime? // When KB was last fully indexed
  kbTotalChunks   Int       @default(0) // Total chunks in stable KB
  kbIndexingError String? // Last indexing error if any

  knowledgeSources          KnowledgeSource[]
  knowledgeChunks           KnowledgeChunk[]
  conversations             Conversation[]
  ingestionJobs             IngestionJob[]
  structuredFacts           StructuredFact[] // Cognitive memory
  entities                  Entity[] // Knowledge Graph entities
  relations                 Relation[] // Knowledge Graph relations
  events                    Event[] // Event Store
  embedSettings             EmbedSettings? // Widget embed settings
  workflows                 Workflow[]
  evaluationCases           EvaluationCase[]
  integrations              IntegrationConnection[]
  actions                   AgentAction[]
  suggestions               ImprovementSuggestion[]
  crmContacts               CRMContact[]
  promptVersions            PromptVersion[]
  aiUsageEvents             AIUsageEvent[]
  products                  Product[]
  productSources            ProductSource[]
  productSyncJobs           ProductSyncJob[]
  commerceEvents            CommerceEvent[]
  commerceWebhookDeliveries CommerceWebhookDelivery[]
  commerceTrackingKey       CommerceTrackingKey?
  backstageSessions         BackstageSession[]
  backstageDrafts           BackstageDraft[]
  responseRevisions         ResponseRevision[]
  apiKeys                   AgentApiKey[]
  workspace                 Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, isActive])
  @@index([companyName])
  @@index([isActive])
  @@index([createdAt])
  @@index([promptTemplateId])
  @@index([kbStatus])
  @@map("chatbots")
}

model BackstageSession {
  id        String   @id @default(uuid())
  botId     String
  title     String
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chatbot  Chatbot            @relation(fields: [botId], references: [id], onDelete: Cascade)
  messages BackstageMessage[]
  drafts   BackstageDraft[]

  @@index([botId, updatedAt])
  @@index([status])
  @@map("backstage_sessions")
}

model BackstageMessage {
  id        String   @id @default(uuid())
  sessionId String
  role      String
  kind      String   @default("message")
  content   String
  evidence  String   @default("[]")
  createdAt DateTime @default(now())

  session BackstageSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("backstage_messages")
}

model BackstageDraft {
  id                String    @id @default(uuid())
  sessionId         String
  botId             String
  type              String
  title             String
  summary           String
  payload           String
  beforeState       String    @default("{}")
  evidence          String    @default("[]")
  validation        String    @default("{}")
  status            String    @default("draft")
  appliedResourceId String?
  approvedAt        DateTime?
  appliedAt         DateTime?
  rolledBackAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  session BackstageSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  chatbot Chatbot          @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([botId, status])
  @@map("backstage_drafts")
}

model AIUsageEvent {
  id                String   @id @default(uuid())
  botId             String?
  conversationId    String?
  feature           String
  provider          String   @default("openai")
  model             String
  inputTokens       Int      @default(0)
  cachedInputTokens Int      @default(0)
  outputTokens      Int      @default(0)
  totalTokens       Int      @default(0)
  estimatedCostUsd  Float    @default(0)
  durationMs        Int?
  success           Boolean  @default(true)
  errorCode         String?
  createdAt         DateTime @default(now())

  chatbot Chatbot? @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, createdAt])
  @@index([conversationId])
  @@index([feature, createdAt])
  @@index([model, createdAt])
  @@map("ai_usage_events")
}

model PromptVersion {
  id               String   @id @default(uuid())
  botId            String
  version          Int
  systemPrompt     String?
  promptTemplateId String?
  settings         String   @default("{}")
  changeSummary    String?
  createdBy        String   @default("owner")
  createdAt        DateTime @default(now())

  chatbot Chatbot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, version])
  @@index([botId, createdAt])
  @@map("prompt_versions")
}

model CRMContact {
  id                 String   @id @default(uuid())
  botId              String
  identityKey        String
  name               String?
  email              String?
  phone              String?
  company            String?
  source             String   @default("chat")
  stage              String   @default("new")
  leadScore          Int      @default(10)
  potentialValue     Float?
  tags               String   @default("[]")
  notes              String   @default("[]")
  consentStatus      String   @default("unknown")
  lastConversationId String?
  lastInteraction    DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  chatbot Chatbot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, identityKey])
  @@index([botId, stage])
  @@index([email])
  @@index([phone])
  @@index([leadScore])
  @@map("crm_contacts")
}

model NotificationState {
  id        String    @id @default(uuid())
  key       String    @unique
  readAt    DateTime?
  dismissed Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([readAt])
  @@index([dismissed])
  @@map("notification_states")
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
  @@map("rate_limit_buckets")
}

model ImprovementSuggestion {
  id            String   @id @default(uuid())
  key           String   @unique
  botId         String?
  category      String
  title         String
  description   String
  impact        String   @default("medium")
  status        String   @default("pending")
  actionType    String
  actionPayload String   @default("{}")
  evidence      String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  chatbot Chatbot? @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, status])
  @@index([category, status])
  @@index([impact])
  @@map("improvement_suggestions")
}

model AgentAction {
  id              String   @id @default(uuid())
  botId           String
  name            String
  type            String
  description     String?
  triggerKeywords String   @default("[]")
  config          String   @default("{}")
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  chatbot        Chatbot           @relation(fields: [botId], references: [id], onDelete: Cascade)
  executions     ActionExecution[]
  widgetVersions WidgetVersion[]

  @@index([botId, enabled])
  @@index([type])
  @@map("agent_actions")
}

model WidgetVersion {
  id            String   @id @default(uuid())
  actionId      String
  version       Int
  definition    String
  changeSummary String?
  createdAt     DateTime @default(now())

  action AgentAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@unique([actionId, version])
  @@index([actionId, createdAt])
  @@map("widget_versions")
}

model ActionExecution {
  id             String   @id @default(uuid())
  actionId       String
  conversationId String?
  success        Boolean
  status         String   @default("pending")
  input          String?
  output         String?
  error          String?
  durationMs     Int?
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  action AgentAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId, createdAt])
  @@index([success, createdAt])
  @@index([status, createdAt])
  @@map("action_executions")
}

model IntegrationConnection {
  id                String    @id @default(uuid())
  botId             String
  provider          String
  category          String
  displayName       String
  externalAccountId String?
  config            String    @default("{}")
  status            String    @default("disconnected")
  enabled           Boolean   @default(false)
  lastTestedAt      DateTime?
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  chatbot Chatbot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, provider])
  @@index([botId, enabled])
  @@index([category])
  @@index([provider, externalAccountId])
  @@map("integration_connections")
}

model EvaluationCase {
  id                String   @id @default(uuid())
  botId             String
  name              String
  question          String
  expectedKeywords  String   @default("[]")
  forbiddenKeywords String   @default("[]")
  conversationTurns String   @default("[]")
  qualityContract   String?
  minimumConfidence Float    @default(0.5)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  chatbot          Chatbot           @relation(fields: [botId], references: [id], onDelete: Cascade)
  runs             EvaluationRun[]
  responseRevision ResponseRevision?

  @@index([botId])
  @@index([isActive])
  @@map("evaluation_cases")
}

model EvaluationRun {
  id             String   @id @default(uuid())
  caseId         String
  passed         Boolean
  response       String
  confidence     Float?
  latencyMs      Int?
  failureReason  String?
  conversationId String?
  metrics        String?
  createdAt      DateTime @default(now())

  evaluationCase EvaluationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@index([passed])
  @@map("evaluation_runs")
}

model Workflow {
  id          String   @id @default(uuid())
  botId       String
  name        String
  description String?
  triggerType String   @default("new_message")
  steps       String   @default("[]")
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chatbot    Chatbot             @relation(fields: [botId], references: [id], onDelete: Cascade)
  executions WorkflowExecution[]

  @@index([botId])
  @@index([isActive])
  @@map("workflows")
}

model WorkflowExecution {
  id             String   @id @default(uuid())
  workflowId     String
  conversationId String?
  messageId      String?
  idempotencyKey String   @unique
  status         String
  trigger        String
  actions        String   @default("[]")
  error          String?
  durationMs     Int?
  createdAt      DateTime @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, createdAt])
  @@index([conversationId, createdAt])
  @@index([status, createdAt])
  @@map("workflow_executions")
}

model KnowledgeSource {
  id               String    @id @default(uuid())
  botId            String
  sourceType       String // "url" or "pdf"
  sourceUrl        String?
  originalFilename String?
  contentText      String
  processedAt      DateTime?
  status           String // "pending", "processing", "completed", "failed"
  createdAt        DateTime  @default(now())
  chunkCount       Int       @default(0)
  errorMessage     String?

  // ASYNC INGESTION: Metadata
  fileSize       Int? // For PDFs
  pageCount      Int? // For PDFs or crawled pages
  ingestionJobId String? // Link to async job

  chatbot          Chatbot           @relation(fields: [botId], references: [id], onDelete: Cascade)
  chunks           KnowledgeChunk[]
  responseRevision ResponseRevision?

  @@index([botId])
  @@index([status])
  @@index([sourceType])
  @@index([ingestionJobId])
  @@map("knowledge_sources")
}

model KnowledgeChunk {
  id        String   @id @default(uuid())
  botId     String
  sourceId  String
  chunkKey  String
  text      String
  embedding String
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  chatbot Chatbot         @relation(fields: [botId], references: [id], onDelete: Cascade)
  source  KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([botId, chunkKey])
  @@index([botId])
  @@index([sourceId])
  @@map("knowledge_chunks")
}

// ASYNC INGESTION: Job Queue
model IngestionJob {
  id        String  @id @default(uuid())
  botId     String
  jobType   String // "crawl", "pdf", "url", "reindex"
  dedupeKey String? @unique
  status    String  @default("pending") // "pending", "running", "completed", "failed"
  priority  Int     @default(5) // 1-10, higher = more urgent

  // Job payload (JSON)
  params String // JSON: {url, maxPages, etc} or {fileId, etc}

  // Progress tracking
  progress        Int     @default(0) // 0-100
  progressMessage String? // "Processing page 5/50"

  // Timing
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  // Results
  sourcesCreated Int     @default(0) // How many KnowledgeSource records created
  chunksCreated  Int     @default(0) // Total chunks indexed
  errorMessage   String?
  errorStack     String? // Full stack trace if failed

  // Retry logic
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  nextRetryAt DateTime?

  chatbot Chatbot @relation(fields: [botId], references: [id], onDelete: Cascade)
  events  Event[] // Event Store

  @@index([botId])
  @@index([status])
  @@index([jobType])
  @@index([priority])
  @@index([createdAt])
  @@index([nextRetryAt])
  @@map("ingestion_jobs")
}

model Conversation {
  id               String    @id @default(uuid())
  botId            String
  userSessionId    String
  startedAt        DateTime  @default(now())
  lastMessageAt    DateTime?
  channel          String    @default("widget")
  externalThreadId String?

  // Conversation metadata
  userIntent    String? // "support", "sales", "info", "complaint"
  sentiment     String? // "positive", "neutral", "negative"
  isResolved    Boolean   @default(false)
  summary       String? // Auto-generated summary for long conversations
  lastSummaryAt DateTime?
  internalNotes String?
  tags          String    @default("[]")

  // Extracted user data
  userName        String?
  userEmail       String?
  userPhone       String?
  userCompany     String?
  extractedData   String? // JSON string for additional custom fields
  topicsDiscussed String? // JSON array of topics

  // UX Enhancement Fields
  needsHumanEscalation Boolean   @default(false)
  escalatedAt          DateTime?
  escalationReason     String?
  assignedAgent        String?

  // Owner-operated Help Desk state. These fields describe the latest
  // escalation cycle; historical transitions belong in the Event store.
  priority             String    @default("normal")
  handoffSequence      Int       @default(0)
  firstResponseDueAt   DateTime?
  resolutionDueAt      DateTime?
  firstHumanResponseAt DateTime?
  lastHumanResponseAt  DateTime?
  resolvedAt           DateTime?
  reopenedAt           DateTime?

  chatbot           Chatbot            @relation(fields: [botId], references: [id], onDelete: Cascade)
  messages          Message[]
  structuredFacts   StructuredFact[] // Cognitive memory
  events            Event[] // Event Store
  responseRevisions ResponseRevision[]

  @@unique([botId, channel, externalThreadId])
  @@index([botId])
  @@index([userSessionId])
  @@index([startedAt])
  @@index([userIntent])
  @@index([sentiment])
  @@index([isResolved])
  @@index([needsHumanEscalation])
  @@index([botId, isResolved, needsHumanEscalation, priority, lastMessageAt], map: "conversations_helpdesk_queue_idx")
  @@index([botId, needsHumanEscalation, firstResponseDueAt], map: "conversations_first_response_sla_idx")
  @@index([botId, isResolved, resolutionDueAt], map: "conversations_resolution_sla_idx")
  @@map("conversations")
}

model Message {
  id                String   @id @default(uuid())
  conversationId    String
  role              String // "user" or "assistant"
  content           String
  createdAt         DateTime @default(now())
  channel           String   @default("widget")
  externalMessageId String?  @unique
  deliveryStatus    String?
  sourcesUsed       String? // JSON string for sources array

  // UX Enhancement Fields
  feedback         String? // "positive", "negative", or null
  feedbackComment  String? // Optional user comment on feedback
  ctaData          String? // JSON string for contextual CTAs
  quickReplies     String? // JSON array of suggested questions
  productCards     String? // JSON array of server-hydrated commerce cards
  operatorAuthored Boolean @default(false)

  conversation      Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  responseRevisions ResponseRevision[]

  @@index([conversationId])
  @@index([createdAt])
  @@index([feedback])
  @@index([channel, createdAt])
  @@map("messages")
}

// Saved filters belong to the single private owner workspace. They contain
// structured filter JSON only; free-text search and visitor PII are excluded
// by the service layer that will expose them.
model HelpDeskSavedView {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  filters     String   @default("{}")
  sort        String   @default("recent")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([workspaceId, isDefault, updatedAt])
  @@index([isDefault, updatedAt])
  @@map("helpdesk_saved_views")
}

// Owner-approved corrections converted into durable Q&A knowledge and
// anti-regression evaluations. Historical assistant messages remain immutable.
model ResponseRevision {
  id                 String    @id @default(uuid())
  botId              String
  conversationId     String
  assistantMessageId String
  version            Int
  question           String
  originalAnswer     String
  revisedAnswer      String
  rationale          String?
  expectedKeywords   String    @default("[]")
  forbiddenKeywords  String    @default("[]")
  status             String    @default("draft")
  knowledgeSourceId  String?   @unique
  evaluationCaseId   String?   @unique
  createdBy          String    @default("owner")
  publishedAt        DateTime?
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  chatbot          Chatbot          @relation(fields: [botId], references: [id], onDelete: Cascade)
  conversation     Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assistantMessage Message          @relation(fields: [assistantMessageId], references: [id], onDelete: Cascade)
  knowledgeSource  KnowledgeSource? @relation(fields: [knowledgeSourceId], references: [id], onDelete: SetNull)
  evaluationCase   EvaluationCase?  @relation(fields: [evaluationCaseId], references: [id], onDelete: SetNull)

  @@unique([assistantMessageId, version])
  @@index([botId, status, updatedAt])
  @@index([conversationId, createdAt])
  @@map("response_revisions")
}

model AgentApiKey {
  id         String    @id @default(uuid())
  botId      String
  name       String
  keyPrefix  String
  secretHash String    @unique
  scopes     String    @default("[\"chat:write\"]")
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  chatbot Chatbot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, revokedAt])
  @@index([keyPrefix])
  @@index([expiresAt])
  @@map("agent_api_keys")
}

// ============================================================================
// VERIFIED COMMERCE CATALOG
// ============================================================================

model ProductSource {
  id          String    @id @default(uuid())
  botId       String
  sourceType  String // "shopify", "woocommerce", "jsonld", "merchant_feed", "sitemap", "manual"
  name        String
  baseUrl     String?
  status      String    @default("active")
  syncEnabled Boolean   @default(true)
  lastSyncAt  DateTime?
  lastError   String?
  metadata    String    @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  chatbot  Chatbot          @relation(fields: [botId], references: [id], onDelete: Cascade)
  products Product[]
  syncJobs ProductSyncJob[]

  @@index([botId, status])
  @@index([sourceType])
  @@map("product_sources")
}

model Product {
  id                    String    @id @default(uuid())
  botId                 String
  sourceId              String?
  identityKey           String
  externalId            String?
  canonicalUrl          String
  title                 String
  description           String    @default("")
  brand                 String?
  productType           String?
  categories            String    @default("[]")
  tags                  String    @default("[]")
  mainImageUrl          String?
  imageUrls             String    @default("[]")
  status                String    @default("active")
  availableForSale      Boolean   @default(true)
  recommendationStatus  String    @default("normal") // "normal", "promoted", "excluded", "blocked"
  rankingBoost          Int       @default(0)
  merchandisingNote     String?
  campaignStart         DateTime?
  campaignEnd           DateTime?
  publishedAt           DateTime?
  lastSyncedAt          DateTime?
  missingSyncCount      Int       @default(0)
  lastMissingSnapshotAt DateTime?
  contentHash           String?
  metadata              String    @default("{}")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  chatbot  Chatbot          @relation(fields: [botId], references: [id], onDelete: Cascade)
  source   ProductSource?   @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  variants ProductVariant[]
  events   CommerceEvent[]

  @@unique([botId, identityKey])
  @@unique([botId, canonicalUrl])
  @@index([botId, status, availableForSale])
  @@index([botId, recommendationStatus])
  @@index([sourceId])
  @@index([sourceId, missingSyncCount])
  @@index([externalId])
  @@index([brand])
  @@map("products")
}

model ProductVariant {
  id             String   @id @default(uuid())
  productId      String
  identityKey    String
  externalId     String?
  sku            String?
  title          String?
  attributes     String   @default("{}")
  price          Float?
  compareAtPrice Float?
  currency       String?
  available      Boolean  @default(true)
  stockQuantity  Int?
  productUrl     String?
  imageUrl       String?
  position       Int      @default(0)
  metadata       String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  events  CommerceEvent[]

  @@unique([productId, identityKey])
  @@index([productId, available])
  @@index([sku])
  @@map("product_variants")
}

model ProductSyncJob {
  id                String    @id @default(uuid())
  botId             String
  sourceId          String
  status            String    @default("pending")
  progress          Int       @default(0)
  productsSeen      Int       @default(0)
  productsCreated   Int       @default(0)
  productsUpdated   Int       @default(0)
  productsFailed    Int       @default(0)
  errorMessage      String?
  attempts          Int       @default(0)
  leaseVersion      Int       @default(0)
  maxAttempts       Int       @default(3)
  checkpoint        String?
  snapshotStartedAt DateTime?
  pagesProcessed    Int       @default(0)
  nextRetryAt       DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())

  chatbot Chatbot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  source  ProductSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([botId, status])
  @@index([sourceId, createdAt])
  @@index([nextRetryAt])
  @@map("product_sync_jobs")
}

model CommerceEvent {
  id              String   @id @default(uuid())
  botId           String
  conversationId  String?
  messageId       String?
  productId       String?
  variantId       String?
  eventType       String // "impression", "click", "compare", "add_to_cart", "checkout", "checkout_item", "conversion", "conversion_item"
  externalEventId String?  @unique
  sessionId       String?
  pageUrl         String?
  value           Float?
  currency        String?
  metadata        String   @default("{}")
  createdAt       DateTime @default(now())

  chatbot Chatbot         @relation(fields: [botId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([botId, eventType, createdAt])
  @@index([conversationId, createdAt])
  @@index([productId, createdAt])
  @@index([sessionId, createdAt])
  @@map("commerce_events")
}

model CommerceWebhookDelivery {
  id          String    @id @default(uuid())
  botId       String
  provider    String
  externalId  String    @unique
  topic       String
  status      String    @default("processing")
  error       String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  chatbot Chatbot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, createdAt])
  @@index([provider, status])
  @@map("commerce_webhook_deliveries")
}

model CommerceTrackingKey {
  id        String   @id @default(uuid())
  botId     String   @unique
  config    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chatbot Chatbot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([active])
  @@map("commerce_tracking_keys")
}

// ============================================================================
// COGNITIVE MEMORY SYSTEM - Structured Facts
// ============================================================================

model StructuredFact {
  id             String @id @default(uuid())
  conversationId String
  botId          String

  // Fact Classification
  factType String // "preference", "profile", "decision", "complaint", "request", "feedback"
  category String // "product", "service", "technical", "billing", etc.

  // Entity Normalization
  entityType String? // "person", "product", "company", "feature", "issue"
  entityName String? // Normalized entity name (e.g., "iPhone 15 Pro" not "iphone", "iPhone", "iphone 15 pro")
  attribute  String? // "price", "feature", "status", "preference", "problem"
  value      String // The actual fact content

  // Confidence & Validity
  confidence Float  @default(1.0) // 0.0 - 1.0
  source     String // "user_stated", "inferred", "extracted"

  // Temporal Management
  extractedAt DateTime  @default(now())
  validFrom   DateTime  @default(now())
  validUntil  DateTime? // For time-bound facts
  isActive    Boolean   @default(true)

  // Conflict Resolution
  supersedes   String? // JSON array of fact IDs this replaces
  supersededBy String? // ID of fact that replaced this one

  // Semantic Search
  embedding      String? // JSON array of embedding vector (1536 dimensions)
  embeddingModel String? // "text-embedding-3-small"

  // Multi-dimensional Indexing
  intent     String? // User intent when fact was extracted
  sentiment  String? // "positive", "neutral", "negative"
  importance Int     @default(5) // 1-10, higher = more important

  // Metadata
  rawText          String? // Original text from which fact was extracted
  extractionMethod String? // "llm", "rule", "user_input"
  metadata         String? // JSON for additional context

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  chatbot      Chatbot      @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([botId])
  @@index([factType])
  @@index([category])
  @@index([entityType])
  @@index([entityName])
  @@index([isActive])
  @@index([extractedAt])
  @@index([confidence])
  @@index([importance])
  @@index([validFrom])
  @@index([validUntil])
  @@map("structured_facts")
}

// ============================================================================
// KNOWLEDGE GRAPH - Entities and Relations
// ============================================================================

model Entity {
  id    String @id @default(uuid())
  botId String

  // Entity Classification
  entityType  String // "product", "service", "person", "company", "feature", "location", "concept"
  entityName  String // Normalized name (e.g., "iPhone 15 Pro", "Customer Support")
  displayName String? // User-friendly name

  // Aliases and Variations (for matching)
  aliases String? // JSON array of alternative names ["iphone 15 pro", "iPhone15Pro"]

  // Entity Attributes
  attributes  String? // JSON object with key-value pairs {"price": "1199", "color": "titanium"}
  description String? // Natural language description
  category    String? // Business category ("hardware", "subscription", "support_topic")

  // Confidence & Source
  confidence    Float   @default(1.0) // 0.0 - 1.0
  extractedFrom String? // Source of extraction ("knowledge_base", "conversation", "manual")

  // Temporal Management
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  // Semantic Search
  embedding      String? // JSON array of embedding vector
  embeddingModel String? // "text-embedding-3-small"

  // Metadata
  metadata String? // JSON for additional domain-specific data
  tags     String? // JSON array of tags ["premium", "flagship"]

  // Relations
  chatbot           Chatbot    @relation(fields: [botId], references: [id], onDelete: Cascade)
  relationsAsSource Relation[] @relation("SourceEntity")
  relationsAsTarget Relation[] @relation("TargetEntity")

  @@unique([botId, entityType, entityName])
  @@index([botId])
  @@index([entityType])
  @@index([entityName])
  @@index([category])
  @@index([isActive])
  @@index([createdAt])
  @@map("entities")
}

model Relation {
  id    String @id @default(uuid())
  botId String

  // Relation Triple: (Source) --[Type]--> (Target)
  sourceEntityId String
  relationType   String // "HAS_FEATURE", "PART_OF", "COMPATIBLE_WITH", "COSTS", "REQUIRES", "REPLACES"
  targetEntityId String

  // Relation Attributes
  attributes    String? // JSON object with properties {"since": "2023", "condition": "with_warranty"}
  strength      Float   @default(1.0) // 0.0 - 1.0 (how strong is this relation)
  bidirectional Boolean @default(false) // If true, implies reverse relation exists

  // Confidence & Source
  confidence    Float   @default(1.0)
  extractedFrom String? // Source of extraction

  // Temporal Management
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  isActive   Boolean   @default(true)
  validFrom  DateTime  @default(now())
  validUntil DateTime?

  // Metadata
  metadata String? // JSON for additional context

  // Navigation
  sourceEntity Entity  @relation("SourceEntity", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntity Entity  @relation("TargetEntity", fields: [targetEntityId], references: [id], onDelete: Cascade)
  chatbot      Chatbot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, sourceEntityId, relationType, targetEntityId])
  @@index([botId])
  @@index([sourceEntityId])
  @@index([targetEntityId])
  @@index([relationType])
  @@index([isActive])
  @@index([validFrom])
  @@index([validUntil])
  @@map("relations")
}

// ============================================================================
// EVENT STORE - Append-only Event Log
// ============================================================================

model Event {
  id String @id @default(uuid())

  // Context (optional - some events are system-wide)
  botId          String?
  conversationId String?
  userId         String? // User session ID from conversation
  jobId          String? // For ingestion events

  // Event Classification
  eventType String // "orchestrator.decision_made", "ingestion.job.completed"
  category  String // "orchestrator", "ingestion", "memory", "retrieval", "validation", "generation", "conversation", "system"
  severity  String // "info", "warning", "error", "critical"

  // Core Structured Fields (for fast queries)
  success      Boolean @default(true)
  durationMs   Int? // Duration of operation in milliseconds
  errorMessage String? // For failed events
  errorStack   String? // Full stack trace for debugging

  // Flexible Metadata (JSON for event-specific data)
  metadata String? // JSON object with event-specific details

  // Temporal
  timestamp DateTime @default(now())

  // Optional Relations (for easy joins)
  chatbot      Chatbot?      @relation(fields: [botId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  ingestionJob IngestionJob? @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // Indexes for common queries
  @@index([botId, timestamp])
  @@index([conversationId, timestamp])
  @@index([jobId, timestamp])
  @@index([eventType, timestamp])
  @@index([category, timestamp])
  @@index([severity, timestamp])
  @@index([success, timestamp])
  @@index([timestamp])
  @@map("events")
}

// ============================================================================
// EMBED SETTINGS - Widget Configuration
// ============================================================================

model EmbedSettings {
  id        String @id @default(uuid())
  chatbotId String @unique

  // Basic Settings
  enabled  Boolean @default(false)
  title    String?
  subtitle String?

  // Appearance
  theme          String  @default("light") // "light" | "dark"
  position       String  @default("bottom-right") // "bottom-right" | "bottom-left" | "top-right" | "top-left"
  primaryColor   String  @default("#007bff")
  secondaryColor String  @default("#825cff")
  launcherColor  String  @default("#633cff")
  brandLogoUrl   String?

  // Widget Shape & Icon
  widgetShape String @default("circle") // "circle" | "rounded" | "square"
  iconType    String @default("emoji") // "emoji" | "logo" | "icon"
  iconValue   String @default("💬") // emoji, logo URL, or icon name
  widgetSize  String @default("medium") // "small" | "medium" | "large"

  // Animation & Effects
  animation Boolean @default(true) // hover animations
  shadow    Boolean @default(true) // drop shadow
  gradient  Boolean @default(true) // gradient background

  // Behavior
  autoOpen                Boolean @default(false)
  showLauncher            Boolean @default(true)
  launcherMessageEnabled  Boolean @default(false)
  launcherMessage         String?
  launcherMessageDelay    Int     @default(1500)
  launcherMessageDuration Int     @default(12000)

  // Advanced Customization
  customCSS      String?
  allowedDomains String? // Comma-separated list of allowed domains

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  chatbot Chatbot @relation(fields: [chatbotId], references: [id], onDelete: Cascade)

  @@map("embed_settings")
}
